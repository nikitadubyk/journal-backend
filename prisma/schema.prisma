generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WorkType {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  workLogs WorkLog[]
}

model WorkLog {
  id         Int      @id @default(autoincrement())
  date       DateTime
  volume     Float
  unit       String
  workerName String
  workTypeId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workType   WorkType @relation(fields: [workTypeId], references: [id])
}
